# Hostinger Email SMTP. For Titan Email, use SMTP_HOST=smtp.titan.email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Use the complete Hostinger mailbox address.
SMTP_USER=info@atwassup.com
# Add the mailbox password in your ignored .env file; never commit it.
SMTP_PASS=
LEAD_INBOX=info@atwassup.com

# Optional logging level: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info
